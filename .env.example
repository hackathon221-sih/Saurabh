# Copy this file to .env and fill only the keys you want to use.
# New Delhi is the default location.

# Optional: Google Calendar public calendar access.
# GOOGLE_CALENDAR_API_KEY=
# GOOGLE_CALENDAR_ID=

# Optional: Ticketmaster Discovery API for live event listings.
# TICKETMASTER_API_KEY=

# Location override (optional)
# SECTORIQ_LAT=28.6139
# SECTORIQ_LON=77.2090
